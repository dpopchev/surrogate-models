# --- regenerable: every artifact a make target produces (rules/makefile.md -> Directories)
# `make clean` removes the whole directory; if that loses something, it was misplaced.
build/

# --- machine-local: inputs, key files, scratch and every tool residual -- never
# tracked, never cleaned.
local/

# --- env files at the repo root, if a launcher still uses one; the contract is .env.example
.env
.env.*
!.env.example

# --- uv-managed environment (`make sync` recreates it)
.venv/

# --- bytecode of python run outside make (a bare uv run); make targets write it under local/pycache
__pycache__/

# --- hatchling writes no egg-info; a setuptools layout would, so it is ignored too
*.egg-info/
